<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wolpertinger.Presentation.ViewModels"
        x:Class="Wolpertinger.Presentation.App.Views.FullscreenHubWindow"
        x:DataType="vm:SmartHubViewModel"
        Title="WOLPERTINGER Fullscreen Hub"
        Width="960" Height="720">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                Spacing="24" Margin="0,0,0,20">
      <TextBlock Text="WOLPERTINGER — Smart Hub"
                 FontSize="24" VerticalAlignment="Center" />
      <Button Content="Close hub" Click="OnCloseHub" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="14">
        <TextBlock x:Name="EmptyState"
                   Text="Connecting — waiting for validated state"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="Body" IsVisible="False" Spacing="10">
          <TextBlock Text="{Binding SystemText}" FontSize="34" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CommanderName, StringFormat='Commander: {0}'}" />
          <TextBlock Text="{Binding ShipText, StringFormat='Vessel: {0}'}" />
          <TextBlock Text="{Binding ContextText, StringFormat='Context: {0}'}" />
          <TextBlock Text="{Binding CompositionText, StringFormat='Composition: {0}'}" />
          <TextBlock Text="{Binding SelectionModeText, StringFormat='Mode: {0}'}" />
          <TextBlock Text="{Binding RuntimeText, StringFormat='Runtime: {0}'}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding FrontierAccountText, StringFormat='Frontier: {0}'}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding JumpDistanceText, StringFormat='Jump distance: {0}'}" />
          <TextBlock Text="{Binding FuelLevelText, StringFormat='Fuel: {0}'}" />
          <TextBlock Text="{Binding SystemSourceText, StringFormat='System source: {0}'}" />
          <TextBlock Text="{Binding SystemFreshnessText, StringFormat='System freshness: {0}'}" />
          <TextBlock Text="{Binding ReasonText, StringFormat='Reason: {0}'}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
