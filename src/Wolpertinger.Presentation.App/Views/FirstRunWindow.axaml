<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Wolpertinger.Presentation.App.Views.FirstRunWindow"
        Title="Welcome to WOLPERTINGER"
        Width="560" Height="420" CanResize="False">
  <StackPanel Margin="32" Spacing="18">
    <TextBlock Text="WOLPERTINGER" FontSize="28" FontWeight="Bold" />
    <TextBlock Text="Local-first Elite Dangerous companion. Choose how to start."
               TextWrapping="Wrap" />
    <Button Content="Connect Frontier Account" Click="OnConnectFrontier" />
    <Button Content="Continue with local data" Click="OnContinueLocal" />
    <Button Content="Try Sample Mode" Click="OnTrySample" />
    <TextBlock Text="Recovery" FontWeight="Bold" Margin="0,8,0,0" />
    <Button Content="Locate Elite data…" Click="OnLocateEliteData" />
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
  </StackPanel>
</Window>
