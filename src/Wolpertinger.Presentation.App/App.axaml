<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wolpertinger.Presentation.App.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/wolpertinger.ico" ToolTipText="WOLPERTINGER">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open WOLPERTINGER" Click="OnOpen" />
            <NativeMenuItem Header="Overlay" Click="OnToggleOverlay" />
            <NativeMenuItem Header="Frontier Account" Click="OnConnectFrontier" />
            <NativeMenuItem Header="Sample Mode" Click="OnEnterSample" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Settings" Click="OnShowSettings" />
            <NativeMenuItem Header="Diagnostics" Click="OnShowDiagnostics" />
            <NativeMenuItem Header="Start with Windows"
                            IsEnabled="False"
                            ToolTip="Requires MSIX package identity" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit WOLPERTINGER" Click="OnExit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
